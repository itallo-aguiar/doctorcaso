          ? '<span class="serif-doc font-bold text-xs sm:text-sm text-stone-900">✒️ Carimbar — Próxima Etapa →</span>'
          : '<span class="serif-doc font-bold text-xs sm:text-sm text-emerald-800">✒️ Alta / Próximo paciente ✓</span>';
      } else {
        feedbackContainer.className = 'rounded-lg p-2.5 border-2 bg-rose-50 border-rose-700 text-rose-950';
        feedbackTitle.className = 'text-xs font-extrabold text-rose-800';
        btnNextStage.classList.add('hidden');
