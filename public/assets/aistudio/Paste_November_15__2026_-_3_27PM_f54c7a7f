    btnNextStage.addEventListener('click', () => {
      playSound('click');
      const c = CASES[currentCaseIndex];
      if (currentStageIndex + 1 < c.stages.length) {
        currentStageIndex++;
        caseProgress[c.id] = currentStageIndex;
        renderStage();
      } else {
        solvedCases[c.id] = true;
        updateHeaderBadges();
        renderCaseTabs();
        addLog(`Caso de <strong>${escapeHtml(c.name.split(',')[0])}</strong> concluído.`, 'success');
        const dayMainDone = CASES.filter(x => x.dia === currentDay && !x.bonus).every(x => solvedCases[x.id]);
        if (!c.bonus && dayMainDone && !summaryShownByDay[currentDay]) {
          summaryShownByDay[currentDay] = true;
          openShiftSummary();
          return;
        }
        const nextInDay = CASES.findIndex((item, i) => {
          if (item.dia !== currentDay) return false;
          if (solvedCases[item.id]) return false;
          if (item.bonus && !bonusUnlocked(currentDay)) return false;
          return i !== currentCaseIndex;
        });
        if (nextInDay !== -1) loadCase(nextInDay);
        else openShiftSummary();
      }
    });

    function openShiftSummary() {
      const modal = document.getElementById('shiftSummaryModal');
      const rankEl = document.getElementById('finalRankText');
      const sumEl = document.getElementById('finalScoreSummary');
      const titleEl = document.getElementById('summaryModalTitle');
      const starEl = document.getElementById('summaryStarBox');
      const switchBtn = document.getElementById('btnSwitchDayFromModal');
      const closeBtn = document.getElementById('btnCloseShiftModal');

      starEl.className = `w-14 h-14 rounded-2xl ${currentDay === 2 ? 'bg-fuchsia-600' : 'bg-emerald-600'} text-white toon-box-sm flex items-center justify-center mx-auto text-2xl font-bold mb-3`;
      titleEl.textContent = `Dia ${currentDay} Concluído!`;

      let rank;
      if (score >= 3000) rank = 'Preceptor Chefe Integrado (Infecto + GO — Padrão-Ouro)';
      else if (score >= 1600) rank = 'Residente Sênior do Plantão PBL 4';
      else if (score >= 900) rank = 'Plantonista Aprovado no PBL 4';
      else rank = 'Acadêmico Plantonista — Continue avançando nos casos!';
      rankEl.textContent = `Classificação: ${rank}`;

      const dayCases = CASES.filter(x => x.dia === currentDay);
      const daySolved = dayCases.filter(x => solvedCases[x.id]).length;
      const totalSolved = CASES.filter(x => solvedCases[x.id]).length;

      const nextBonus = CASES.findIndex((x) => x.dia === currentDay && x.bonus && !solvedCases[x.id]);
      closeBtn.textContent = nextBonus !== -1 ? `Ir para Bônus do Dia ${currentDay} →` : 'Continuar revisando';
      closeBtn.dataset.goto = nextBonus !== -1 ? String(nextBonus) : '';

      const otherDay = currentDay === 1 ? 2 : 1;
      switchBtn.textContent = otherDay === 2 ? '🌸 Ir para o Dia 2 (Mulher) →' : '🌿 Ir para o Dia 1 (Ambiental) →';
      switchBtn.className = `px-3.5 py-2 rounded-xl ${otherDay === 2 ? 'bg-fuchsia-600 hover:bg-fuchsia-500' : 'bg-emerald-600 hover:bg-emerald-500'} toon-box-sm text-xs font-bold text-white`;

      sumEl.innerHTML = `Progresso no <strong>Dia ${currentDay}</strong>: <strong>${daySolved}/${dayCases.length} casos</strong>.<br>Progresso geral (Dia 1 + Dia 2): <strong>${totalSolved}/${CASES.length} casos</strong> · <strong>${score} pontos</strong>.<br>Eventos adversos acumulados: <strong>${adverseEvents.length}</strong>.`;
      modal.classList.remove('hidden'); modal.classList.add('flex');
    }

    const ecgCanvas = document.getElementById('ecgCanvas');
    const ctx = ecgCanvas.getContext('2d');
    let ecgPhase = 0;
    function resizeEcgCanvas() {
      const rect = ecgCanvas.parentElement.getBoundingClientRect();
      ecgCanvas.width = Math.max(70, Math.floor(rect.width));
      ecgCanvas.height = Math.max(32, Math.floor(rect.height));
    }
    function ecgSample(t, type) {
      const p = t % 1; let y = 0;
      if (p > 0.12 && p < 0.22) y += 0.18 * Math.sin(((p - 0.12) / 0.1) * Math.PI);
      if (p >= 0.26 && p < 0.29) y -= 0.22 * Math.sin(((p - 0.26) / 0.03) * Math.PI);
      if (p >= 0.29 && p < 0.34) y += 1.0 * Math.sin(((p - 0.29) / 0.05) * Math.PI);
      if (p >= 0.34 && p < 0.38) y -= 0.3 * Math.sin(((p - 0.34) / 0.04) * Math.PI);
      if (type === 'hypokalemia') { if (p >= 0.46 && p < 0.58) y += 0.12 * Math.sin(((p - 0.46) / 0.12) * Math.PI); if (p >= 0.60 && p < 0.74) y += 0.25 * Math.sin(((p - 0.60) / 0.14) * Math.PI); }
      else if (p >= 0.46 && p < 0.62) y += 0.32 * Math.sin(((p - 0.46) / 0.16) * Math.PI);
      return y;
    }
    function drawEcgFrame() {
      const w = ecgCanvas.width, h = ecgCanvas.height;
      ctx.clearRect(0, 0, w, h);
      const c = CASES[currentCaseIndex];
      const type = c ? c.vitals.waveType : 'normal';
      ecgPhase += 0.00023 * (vs ? vs.hr : 78);
      ctx.strokeStyle = stability < 45 ? '#f43f5e' : (currentDay === 2 ? '#d946ef' : '#10b981');
      ctx.lineWidth = 1.6; ctx.beginPath();
      const midY = h * 0.56, amp = h * 0.36;
      for (let x = 0; x < w; x++) {
        const t = ecgPhase + x / 45;
        const val = ecgSample(t, type);
        const py = midY - val * amp;
        if (x === 0) ctx.moveTo(x, py); else ctx.lineTo(x, py);
      }
      ctx.stroke();
      requestAnimationFrame(drawEcgFrame);
    }

    function renderObjetivos(dayToShow = activeObjModalDay) {
      activeObjModalDay = dayToShow;
      const body = document.getElementById('objetivosBody');
      const btn1 = document.getElementById('btnObjTab1');
      const btn2 = document.getElementById('btnObjTab2');
      btn1.className = dayToShow === 1 ? 'px-2.5 py-1 rounded text-xs font-extrabold bg-emerald-600 text-white' : 'px-2.5 py-1 rounded text-xs font-extrabold bg-stone-700 text-stone-200 hover:bg-stone-600';
      btn2.className = dayToShow === 2 ? 'px-2.5 py-1 rounded text-xs font-extrabold bg-fuchsia-600 text-white' : 'px-2.5 py-1 rounded text-xs font-extrabold bg-stone-700 text-stone-200 hover:bg-stone-600';

      const cob = new Set();
      CASES.filter(c => c.dia === dayToShow).forEach((c) => {
        c.stages.forEach((s, si) => {
          if (scoredStages[`${c.id}:${si}`] && s.obj) cob.add(s.obj);
        });
      });

      const titulosD1 = {
        1: 'Ecoepidemiologia e fisiopatologia (HAV, Symmers e Síndrome de Löffler)',
        2: 'Interpretação laboratorial (padrão dissociado na Weil, hepatocelular e coagulograma)',
        3: 'Fisiopatologia e mecanismo de ação do veneno botrópico',
        4: 'Alterações farmacocinéticas na IRA e toxicidade por paracetamol (CYP2E1/NAPQI)',
        5: 'Escolha racional de antimicrobianos, antiparasitários e manejo de anafilaxia',
        6: 'Diagnóstico sindrômico diferencial e complicações (SPHL, IHA, síndrome compartimental)',
        7: 'Vigilância epidemiológica (SINAN), profilaxia pós-exposição e suporte',
        8: 'Plano terapêutico intensivo integrado na Síndrome Pulmonar Hemorrágica (SPHL)'
      };
      const titulosD2 = {
        1: 'Ciclo reprodutivo e eixo HHO / Fisiologia do climatério (STRAW+10) / Pré-eclâmpsia e invasão trofoblástica',
        2: 'Classificação de LARCs / Neurônios KNDy (Kisspeptina, NKB, Dinorfina) / HPP (4 Ts) e Endometriose',
        3: 'Farmacologia dos contraceptivos e indutores do CYP3A4 / Estabilização na síndrome HELLP e crise hipertensiva',
        4: 'Elegibilidade OMS (DIU cobre e SIU-LNG) / THM transdérmica / MgSO₄, gluconato de cálcio e uterotônicos na HAS',
        5: 'Saúde óssea (RANKL/OPG, bisfosfonatos, denosumabe e SERMs) / Manejo do SUA na adolescência e endometriose',
        6: 'Contracepção de emergência / Terapias não hormonais (fezolinetanto e CYP2D6/tamoxifeno) / Ácido tranexâmico',
        7: 'Síndrome geniturinária da menopausa (SGM) e seguimento clínico',
        8: 'Planejamento familiar compartilhado / Manejo integrado da HPP refratária (Balão de Bakri, B-Lynch e transfusão 1:1:1)'
      };
      const map = dayToShow === 2 ? titulosD2 : titulosD1;
      const activeBoxCls = dayToShow === 2 ? 'bg-fuchsia-100 border-2 border-fuchsia-700' : 'bg-emerald-100 border-2 border-emerald-700';
      const activeBadgeCls = dayToShow === 2 ? 'bg-fuchsia-600 text-white' : 'bg-emerald-600 text-white';
      const activeTextCls = dayToShow === 2 ? 'font-bold text-fuchsia-900' : 'font-bold text-emerald-900';

      body.innerHTML = Object.entries(map).map(([n, t]) => {
        const ok = cob.has(parseInt(n, 10));
        return `<div class="p-2 rounded ${ok ? activeBoxCls : 'bg-stone-100 border-2 border-stone-400'} flex items-center gap-2">
          <span class="w-6 h-6 rounded-full ${ok ? activeBadgeCls : 'bg-stone-400 text-stone-700'} flex items-center justify-center font-bold text-xs shrink-0">${ok ? '✓' : n}</span>
          <span class="${ok ? activeTextCls : 'text-stone-600'} text-xs">Objetivo ${n} — ${t}</span>
        </div>`;
      }).join('');
    }

    function setVmTab(dayNum) {
      const b1 = document.getElementById('vmBodyDay1');
      const b2 = document.getElementById('vmBodyDay2');
      const t1 = document.getElementById('btnVmTab1');
      const t2 = document.getElementById('btnVmTab2');
      b1.classList.toggle('hidden', dayNum !== 1);
      b2.classList.toggle('hidden', dayNum !== 2);
      t1.className = dayNum === 1 ? 'px-2.5 py-1 rounded text-xs font-extrabold bg-emerald-600 text-white' : 'px-2.5 py-1 rounded text-xs font-extrabold bg-stone-700 text-stone-200 hover:bg-emerald-700';
      t2.className = dayNum === 2 ? 'px-2.5 py-1 rounded text-xs font-extrabold bg-fuchsia-600 text-white' : 'px-2.5 py-1 rounded text-xs font-extrabold bg-stone-700 text-stone-200 hover:bg-fuchsia-700';
    }

    document.getElementById('btnSelectDay1').addEventListener('click', () => { playSound('click'); switchDay(1); });
    document.getElementById('btnSelectDay2').addEventListener('click', () => { playSound('click'); switchDay(2); });
    document.getElementById('btnWallCalendar').addEventListener('click', () => { playSound('click'); switchDay(currentDay === 1 ? 2 : 1); });

    document.getElementById('btnLabHemo').addEventListener('click', () => unlockLab('hemo'));
    document.getElementById('btnLabBio').addEventListener('click', () => unlockLab('bio'));
    document.getElementById('btnLabEsp').addEventListener('click', () => unlockLab('esp'));
    document.getElementById('btnExamHead').addEventListener('click', () => inspectBodyPart('head'));
    document.getElementById('btnExamThorax').addEventListener('click', () => inspectBodyPart('thorax'));
    document.getElementById('btnExamAbdomen').addEventListener('click', () => inspectBodyPart('abdomen'));
    document.getElementById('btnExamLegs').addEventListener('click', () => inspectBodyPart('legs'));

    roomCanvas.addEventListener('click', (e) => {
      const r = roomCanvas.getBoundingClientRect(), g = charAnim.geom; if (!g) return;
      const ly = ((e.clientY - r.top) * (roomCanvas.height / r.height) - g.baseY) / g.scale;
      inspectBodyPart(ly < -125 ? 'head' : ly < -30 ? 'thorax' : 'abdomen');
    });

    document.getElementById('btnFolderLog').addEventListener('click', () => {
      playSound('click'); renderObjetivos(currentDay);
      const m = document.getElementById('objetivosModal');
      m.classList.remove('hidden'); m.classList.add('flex');
    });
    document.getElementById('btnObjTab1').addEventListener('click', () => { playSound('click'); renderObjetivos(1); });
    document.getElementById('btnObjTab2').addEventListener('click', () => { playSound('click'); renderObjetivos(2); });
    document.getElementById('btnCloseObjetivos').addEventListener('click', () => {
      const m = document.getElementById('objetivosModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    });

    document.getElementById('btnToggleSound').addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      document.getElementById('soundIcon').textContent = soundEnabled ? '🔊' : '🔇';
      if (soundEnabled) playSound('click'); else stopSpeech();
    });

    document.getElementById('btnOpenDrugRef').addEventListener('click', () => {
      playSound('click');
      setVmTab(currentDay);
      const m = document.getElementById('drugRefModal');
      m.classList.remove('hidden'); m.classList.add('flex');
    });
    document.getElementById('btnVmTab1').addEventListener('click', () => { playSound('click'); setVmTab(1); });
    document.getElementById('btnVmTab2').addEventListener('click', () => { playSound('click'); setVmTab(2); });
    document.getElementById('btnCloseDrugRef').addEventListener('click', () => {
      const m = document.getElementById('drugRefModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    });

    function resetFullGame() {
      playSound('click');
      summaryShownByDay[1] = false;
      summaryShownByDay[2] = false;
      Object.keys(caseStability).forEach((k) => delete caseStability[k]);
      score = 0; scoredStages = {}; caseProgress = {}; solvedCases = {}; unlockedLabs = {}; adverseEvents = [];
      clinicalLog.innerHTML = '';
      const m = document.getElementById('shiftSummaryModal');
      m.classList.add('hidden'); m.classList.remove('flex');
      switchDay(1, 0);
    }
    document.getElementById('btnResetGame').addEventListener('click', resetFullGame);
    document.getElementById('btnRestartFromModal').addEventListener('click', resetFullGame);
    document.getElementById('btnCloseShiftModal').addEventListener('click', (e) => {
      const m = document.getElementById('shiftSummaryModal');
      m.classList.add('hidden'); m.classList.remove('flex');
      const go = e.currentTarget.dataset.goto;
      if (go) loadCase(parseInt(go, 10));
    });
    document.getElementById('btnSwitchDayFromModal').addEventListener('click', () => {
      playSound('click');
      const m = document.getElementById('shiftSummaryModal');
      m.classList.add('hidden'); m.classList.remove('flex');
      switchDay(currentDay === 1 ? 2 : 1);
    });

    function closeModal(m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    ['drugRefModal','objetivosModal','shiftSummaryModal'].forEach((id) => {
      const m = document.getElementById(id);
      m.addEventListener('click', (e) => { if (e.target === m) closeModal(m); });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') ['drugRefModal','objetivosModal','shiftSummaryModal'].forEach((id) => closeModal(document.getElementById(id)));
    });

    window.addEventListener('resize', () => { resizeRoomCanvas(); resizeEcgCanvas(); });
    if (window.ResizeObserver) {
      new ResizeObserver(resizeRoomCanvas).observe(roomCanvas.parentElement);
      new ResizeObserver(resizeEcgCanvas).observe(ecgCanvas.parentElement);
    }

    window.onload = () => {
      resizeRoomCanvas(); resizeEcgCanvas();
      switchDay(1, 0);
      voiceUiReady = true; loadVoices();
      setInterval(vitalsTick, 1000);
      requestAnimationFrame(drawCartoonPatient);
      requestAnimationFrame(drawEcgFrame);
    };
  </script>
</body>
</html>