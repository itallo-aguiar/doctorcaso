<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultório Dr. Itallo — PBL 4 · Plantão Integrado (Dias 1 e 2)</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&family=Merriweather:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background-color: #1c1917; color: #1c1917; overflow-x: hidden; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .serif-doc { font-family: 'Merriweather', Georgia, serif; }
    .wall-tiles {
      background-color: #ded8ca;
      background-image:
        radial-gradient(circle at 50% 42%, rgba(255, 251, 235, 0.78) 0%, rgba(214, 207, 190, 0.35) 55%, rgba(168, 162, 148, 0.65) 100%),
        linear-gradient(to right, rgba(120, 113, 108, 0.25) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(120, 113, 108, 0.25) 1px, transparent 1px);
      background-size: 100% 100%, 36px 36px, 36px 36px;
    }
    .wall-teal { background: linear-gradient(180deg, #5c93a4 0%, #467687 100%); border-top: 4px solid #1e293b; border-bottom: 4px solid #1e293b; }
    .wood-desk { background: linear-gradient(180deg, #9c5a25 0%, #85491b 45%, #6e3b14 100%); border-top: 5px solid #291507; box-shadow: inset 0 6px 16px rgba(0,0,0,0.35); }
    .toon-box { border: 3px solid #1c1917; box-shadow: 4px 5px 0px rgba(28, 25, 23, 0.35); }
    .toon-box-sm { border: 2.5px solid #1c1917; box-shadow: 2px 3px 0px rgba(28, 25, 23, 0.3); }
    .tractor-paper {
      background: repeating-linear-gradient(180deg, #bfe3e0 0px, #bfe3e0 22px, #d8f0ee 22px, #d8f0ee 44px);
      border: 3px solid #1c1917; box-shadow: 5px 6px 0px rgba(0, 0, 0, 0.35);
    }
    .tractor-holes { background-image: radial-gradient(#1c1917 30%, transparent 33%); background-size: 14px 20px; background-repeat: repeat-y; background-position: center; }
    .rx-pad { background-color: #fcfbf7; border: 3px solid #1c1917; box-shadow: 6px 8px 0px rgba(0, 0, 0, 0.4); }
    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.08); }
    .custom-scroll::-webkit-scrollbar-thumb { background: #475569; border-radius: 9999px; }
    @keyframes stampSlam { 0% { transform: scale(1.35) rotate(-6deg); opacity: 0.4; } 70% { transform: scale(0.95) rotate(-2deg); opacity: 1; } 100% { transform: scale(1) rotate(-2deg); opacity: 1; } }
    .stamp-anim { animation: stampSlam 0.25s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
    @keyframes pulse-red { 0%,100% { box-shadow: 0 0 0 0 rgba(244,63,94,0.7); } 50% { box-shadow: 0 0 0 8px rgba(244,63,94,0); } }
    .critical-pulse { animation: pulse-red 1.2s infinite; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .fade-up { animation: fadeUp 0.3s ease-out; }
    .tab-locked { opacity: 0.5; cursor: not-allowed; }
    @media (max-width: 639px){ #speechBubble{ left:4.75rem!important; transform:none!important; width:calc(100% - 5.5rem)!important; } }
    #speechBubble.bubble-min { width: auto !important; left: 0.5rem !important; transform: none !important; padding-top: 0.25rem; padding-bottom: 0.25rem; }
    #speechBubble.bubble-min #bubbleBody { display: none; }
    @media (max-width: 639px){ #speechBubble.bubble-min{ left:4.75rem!important; width:auto!important; } }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-stone-900 text-stone-900 select-none">

  <header class="bg-stone-900 border-b-2 border-stone-800 text-stone-100 z-40">
    <div class="max-w-7xl mx-auto px-3 py-1.5 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span id="pblBadge" class="px-2 py-0.5 rounded bg-emerald-600 text-white font-extrabold text-xs tracking-wider uppercase transition-colors">PBL 4</span>
        <div class="inline-flex rounded-lg bg-stone-800 p-0.5 border border-stone-700" role="group" aria-label="Seletor de Dia do Plantão">
          <button id="btnSelectDay1" type="button" class="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider transition bg-emerald-500 text-stone-950 shadow">🌿 Dia 1 · Ambiental</button>
          <button id="btnSelectDay2" type="button" class="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider transition text-stone-300 hover:text-white">🌸 Dia 2 · Mulher</button>
        </div>
        <h1 id="headerSubtitle" class="text-xs sm:text-sm font-bold text-stone-200 hidden sm:inline">Dr. Itallo Aguiar — Infectologia &amp; Toxicologia</h1>
      </div>
      <div class="flex items-center gap-1 overflow-x-auto custom-scroll py-0.5" id="caseTabsContainer"></div>
      <div class="flex items-center gap-1.5 flex-wrap">
        <div class="bg-stone-800 border border-stone-700 rounded px-2 py-0.5 text-[11px] flex items-center gap-1" title="Casos principais resolvidos neste dia"><span class="text-stone-400">Dia:</span><span id="solvedCountBadge" class="mono font-bold text-emerald-400">0/3</span></div>
        <div class="bg-stone-800 border border-stone-700 rounded px-2 py-0.5 text-[11px] flex items-center gap-1" title="Total de casos principais resolvidos (Dia 1 + Dia 2)"><span class="text-stone-400">Geral:</span><span id="totalSolvedBadge" class="mono font-bold text-sky-400">0/6</span></div>
        <div class="bg-stone-800 border border-stone-700 rounded px-2 py-0.5 text-[11px] flex items-center gap-1"><span class="text-stone-400">Pontos:</span><span id="scoreBadge" class="mono font-bold text-amber-400">0</span></div>
        <button id="btnOpenDrugRef" type="button" class="px-2 py-0.5 rounded bg-red-700 hover:bg-red-600 text-white text-[11px] font-bold transition">💊 Vade Mecum</button>
        <button id="btnToggleSound" type="button" class="px-2 py-0.5 rounded bg-stone-800 hover:bg-stone-700 border border-stone-700 text-[11px] text-stone-200 flex items-center gap-1"><span id="soundIcon">🔊</span></button>
        <button id="btnResetGame" type="button" class="px-2 py-0.5 rounded bg-stone-800 hover:bg-rose-900 border border-stone-700 text-[11px] text-stone-300">Reiniciar</button>
      </div>
    </div>
  </header>

  <main class="flex-1 relative max-w-7xl w-full mx-auto overflow-hidden flex flex-col justify-between min-h-[650px] border-x-4 border-stone-950 shadow-2xl">

    <div class="relative flex-1 wall-tiles flex flex-col justify-end overflow-hidden min-h-[420px]">

      <div class="absolute top-3 left-3 z-30 flex flex-col gap-2">
        <button id="btnExamHead" type="button" title="Examinar Olhos e Pele" class="w-14 h-14 bg-stone-100 hover:bg-amber-100 toon-box rounded-lg flex flex-col items-center justify-center p-1 transition"><span class="text-[10px] font-extrabold text-stone-800 leading-tight text-center">👁️ Olhos/Pele</span></button>
        <button id="btnExamThorax" type="button" title="Auscultar Tórax" class="w-14 h-14 bg-stone-100 hover:bg-amber-100 toon-box rounded-lg flex flex-col items-center justify-center p-1 transition"><span id="lblExamThorax" class="text-[10px] font-extrabold text-stone-800 leading-tight text-center">🫁 Tórax</span></button>
        <button id="btnExamAbdomen" type="button" title="Palpar Abdome" class="w-14 h-14 bg-stone-100 hover:bg-amber-100 toon-box rounded-lg flex flex-col items-center justify-center p-1 transition"><span id="lblExamAbdomen" class="text-[10px] font-extrabold text-stone-800 leading-tight text-center">✋ Abdome</span></button>
        <button id="btnExamLegs" type="button" title="Avaliar Pernas e Reflexos" class="w-14 h-14 bg-stone-100 hover:bg-amber-100 toon-box rounded-lg flex flex-col items-center justify-center p-1 transition"><span id="lblExamLegs" class="text-[10px] font-extrabold text-stone-800 leading-tight text-center">🦵 Pernas</span></button>
      </div>

      <div class="pointer-events-none absolute inset-0 z-0">
        <div class="absolute top-12 left-28 w-28 h-36 bg-stone-50 toon-box p-2.5 hidden lg:flex flex-col gap-1.5">
          <div id="posterBar1" class="w-12 h-3 bg-stone-700 transition-colors"></div>
          <div id="posterBar2" class="w-10 h-2.5 bg-stone-700 transition-colors"></div>
          <div class="w-full h-1.5 bg-red-600 mt-2"></div>
          <div class="w-full h-1.5 bg-red-600"></div>
          <div class="w-4/5 h-1.5 bg-red-600"></div>
          <div id="posterLabel" class="mt-auto text-[8px] font-bold text-stone-500 uppercase">Protocolo SINAN</div>
        </div>
        <div class="absolute top-6 left-[34%] sm:left-[37%] w-11 h-72 bg-stone-50 toon-box flex flex-col justify-between py-2 px-1 font-mono text-[11px] font-extrabold text-stone-900">
          <div id="rulerMarker" class="absolute left-0 right-0 h-0.5 bg-red-600 transition-all duration-500 z-10"><span id="rulerMarkerLabel" class="absolute left-full ml-1 -top-2 px-1 rounded bg-red-600 text-white text-[9px] whitespace-nowrap"></span></div>
          <div class="flex items-center justify-between border-b border-stone-400"><span>-</span><span>190</span></div>
          <div class="flex items-center justify-between border-b border-stone-400"><span>-</span><span>180</span></div>
          <div class="flex items-center justify-between border-b border-stone-400"><span>-</span><span>170</span></div>
          <div class="flex items-center justify-between border-b border-stone-400"><span>-</span><span>160</span></div>
          <div class="flex items-center justify-between border-b border-stone-400"><span>-</span><span>150</span></div>
          <div class="flex items-center justify-between border-b border-stone-400"><span>-</span><span>140</span></div>
          <div class="flex items-center justify-between"><span>-</span><span>130</span></div>
        </div>
      </div>

      <!-- Calendário de parede clicável para alternar Dia 1 / Dia 2 -->
      <button id="btnWallCalendar" type="button" title="Clique para alternar entre Dia 1 (Ambiental) e Dia 2 (Saúde da Mulher)" class="absolute top-12 right-[23%] z-20 hidden lg:flex flex-col items-center group cursor-pointer focus:outline-none">
        <div class="w-6 h-4 border-t-2 border-l-2 border-r-2 border-stone-800 transform rotate-45 -mb-2"></div>
        <div id="wallCalendarBox" class="w-28 h-18 bg-red-600 group-hover:scale-105 toon-box flex flex-col items-center justify-center p-1.5 transition">
          <span id="wallCalendarDay" class="text-[10px] font-extrabold text-white tracking-wider uppercase border-b border-white/40 pb-0.5">DIA 1 ⇄</span>
          <span id="wallCalendarTheme" class="text-xs font-black text-amber-200 mt-0.5">AMBIENTAL</span>
          <span class="text-[8px] font-bold text-white/80 mt-0.5">Trocar plantão</span>
        </div>
      </button>

      <div class="absolute bottom-0 inset-x-0 h-24 wall-teal z-0"></div>

      <div class="absolute inset-0 z-10 flex items-end justify-center pointer-events-none">
        <canvas id="roomCanvas" class="w-full h-full block pointer-events-auto cursor-pointer"></canvas>
      </div>

      <div id="speechBubble" class="absolute top-2 z-20 mx-auto max-w-md bg-amber-50 toon-box rounded-2xl px-3.5 py-2 text-xs text-stone-900 transition-all duration-300" style="left: 50%; transform: translateX(-50%); width: calc(100% - 2rem); max-width: 28rem;">
        <div class="flex items-start gap-2">
          <span id="speechAvatar" class="text-base shrink-0">💬</span>
          <div id="bubbleBody" class="min-w-0 flex-1">
            <p id="patientStory" class="font-bold text-stone-900 leading-snug"></p>
            <select id="voiceSelect" title="Escolher a voz deste paciente" class="hidden mt-1 w-full max-w-[14rem] text-[10px] bg-white border border-stone-700 rounded px-1 py-0.5 text-stone-800"></select>
            <div id="examFindingBanner" class="hidden mt-1.5 pt-1.5 border-t border-stone-300 text-[11px] font-extrabold text-emerald-800 cursor-pointer"></div>
          </div>
          <button id="btnSpeak" type="button" title="Ouvir paciente" class="shrink-0 w-5 h-5 leading-none rounded bg-stone-200 hover:bg-stone-300 border border-stone-800 text-[11px] text-stone-800">🗣️</button>
          <button id="btnBubbleMin" type="button" title="Minimizar / mostrar fala" class="shrink-0 w-5 h-5 leading-none rounded bg-stone-200 hover:bg-stone-300 border border-stone-800 text-[11px] font-black text-stone-800">–</button>
        </div>
      </div>

      <div id="enteringOverlay" class="hidden pointer-events-none absolute inset-x-0 top-14 z-30 justify-center">
        <div class="bg-stone-900/95 text-amber-300 border-2 border-amber-400 rounded-xl px-4 py-2 shadow-xl text-center">
          <h3 id="enteringTitle" class="text-xs sm:text-sm font-extrabold">Paciente entrando...</h3>
          <p id="enteringSubtitle" class="text-[11px] text-emerald-300"></p>
        </div>
      </div>
    </div>

    <div class="relative z-20 wood-desk min-h-[320px] sm:min-h-[340px] px-3 sm:px-5 py-3 grid grid-cols-1 lg:grid-cols-12 gap-4 items-end">

      <div class="lg:col-span-5 flex flex-col gap-2.5 relative z-20">

        <div id="patientHeaderCard" class="bg-emerald-700 text-white toon-box rounded-xl p-3 relative transition-colors">
          <div id="patientHeaderDivider" class="flex items-center justify-between border-b border-emerald-500/50 pb-1.5 mb-2">
            <span class="text-[11px] font-extrabold tracking-wide uppercase text-white/90">Cartão Nacional de Saúde • Vitaline</span>
            <div class="flex items-center gap-1.5">
              <span id="patientBedBadge" class="text-[10px] font-bold bg-black/30 px-1.5 py-0.5 rounded">—</span>
              <span id="patientDayBadge" class="text-[10px] font-bold bg-amber-500 text-stone-950 px-1.5 py-0.5 rounded">—</span>
            </div>
          </div>
          <div class="flex items-center justify-between gap-3">
            <div class="w-10 h-8 rounded bg-amber-400 border-2 border-stone-900 grid grid-cols-3 gap-0.5 p-0.5 shrink-0">
              <div class="border border-stone-800/50"></div><div class="border border-stone-800/50"></div><div class="border border-stone-800/50"></div>
              <div class="border border-stone-800/50"></div><div class="border border-stone-800/50"></div><div class="border border-stone-800/50"></div>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-amber-300 font-black text-base tracking-tight leading-none">vitaline • SUS</div>
              <p id="patientEpidemiology" class="text-[11px] text-white/90 font-medium mt-1 leading-tight"></p>
              <span id="arrivalModeBadge" class="inline-block mt-1 text-[10px] font-bold bg-black/40 text-amber-300 px-2 py-0.5 rounded">—</span>
            </div>
            <div class="text-right shrink-0">
              <span class="text-[9px] uppercase text-white/80 block font-bold">Estabilidade</span>
              <span id="stabilityValue" class="mono text-lg font-black text-amber-300">85%</span>
            </div>
          </div>
          <div class="w-full h-2 bg-black/40 rounded-full overflow-hidden mt-2 border border-stone-900">
            <div id="stabilityBar" class="h-full bg-amber-400 transition-all duration-500" style="width: 85%;"></div>
          </div>
        </div>

        <div class="bg-sky-50 text-stone-900 toon-box rounded-xl overflow-hidden">
          <div class="bg-blue-900 text-white px-3 py-1 flex items-center justify-between">
            <span class="text-[10px] font-black tracking-widest uppercase">FAMEJIPA • FICHA CLÍNICA</span>
            <span id="fichaCodeBadge" class="mono text-[10px] text-sky-200">ID-PBL4-D1</span>
          </div>
          <div class="p-2.5 flex items-start gap-3 bg-gradient-to-r from-sky-100 via-white to-sky-100">
            <div class="w-14 h-16 rounded bg-stone-200 border-2 border-stone-800 flex flex-col items-center justify-center shrink-0 overflow-hidden">
              <span id="idCardAvatarEmoji" class="text-3xl">👨‍🦳</span>
              <span class="text-[8px] font-mono font-bold uppercase text-stone-600 mt-0.5">FOTO 3x4</span>
            </div>
            <div class="flex-1 text-[11px] leading-tight space-y-1 font-mono min-w-0">
              <div><span class="text-stone-500">Nome:</span> <strong id="patientName" class="text-stone-950 font-extrabold">—</strong></div>
              <div id="patientMedsBox" class="bg-amber-100/90 border border-amber-400 rounded p-1.5 text-[10px] font-sans">
                <strong class="text-amber-900 uppercase block">Medicações em uso:</strong>
                <span id="patientMedsList" class="text-stone-800 font-semibold"></span>
              </div>
            </div>
          </div>
          <div id="fichaMrz" class="bg-stone-100 px-3 py-1 border-t border-stone-300 mono text-[9px] text-stone-500 tracking-widest truncate">IDBRAPBL4&lt;&lt;&lt;&lt;DIA1E2&lt;&lt;&lt;&lt;FAMEJIPA2026</div>
        </div>

        <div class="flex items-center gap-2 pt-1">
          <button id="btnFolderLog" type="button" class="bg-amber-400 hover:bg-amber-300 text-stone-950 toon-box-sm rounded-lg px-2.5 py-2 flex items-center gap-1.5 transform -rotate-2 transition shrink-0">
            <span class="text-base">📁</span>
            <span class="bg-amber-100 border border-stone-800 px-1.5 py-0.5 text-[9px] font-black tracking-wider uppercase">OBJETIVOS</span>
          </button>
          <div class="flex-1 bg-stone-800 text-emerald-400 toon-box-sm rounded-lg p-1.5 flex items-center gap-2">
            <div class="w-20 h-9 bg-stone-950 rounded border border-stone-700 overflow-hidden shrink-0 relative">
              <canvas id="ecgCanvas" class="w-full h-full block"></canvas>
            </div>
            <div class="grid grid-cols-4 gap-1 flex-1 text-center mono text-[10px]">
              <div><span class="text-[8px] text-stone-400 block">FC</span><strong id="vitalHR" class="text-emerald-400">—</strong></div>
              <div><span class="text-[8px] text-stone-400 block">PA</span><strong id="vitalBP" class="text-amber-400">—</strong></div>
              <div><span class="text-[8px] text-stone-400 block">SpO₂</span><strong id="vitalSpO2" class="text-sky-400">—</strong></div>
              <div><span class="text-[8px] text-stone-400 block">ACHADO</span><strong id="vitalK" class="text-rose-400">—</strong></div>
            </div>
          </div>
        </div>
      </div>

      <div id="roomSidePanel" class="lg:col-span-7 relative flex flex-col xl:flex-row items-stretch gap-3 z-30 min-w-0">
        <div class="flex-1 min-w-0 rx-pad rounded-sm p-3.5 sm:p-4 flex flex-col justify-between relative overflow-hidden text-stone-900">
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-[0.06] text-8xl font-serif select-none">⚕</div>
          <div id="rxPadHeader" class="relative z-10 border-b-2 border-sky-600/60 pb-2 mb-2.5 flex items-start justify-between gap-2">
            <div>
              <h2 id="rxDocName" class="serif-doc text-sm sm:text-base font-bold text-sky-900 leading-tight">Dr. Itallo Aguiar</h2>
              <p id="rxDocSpecialty" class="serif-doc italic text-[11px] text-sky-700">Infectologia &amp; Toxicologia — PBL 4 (Dia 1)</p>
            </div>
            <div class="text-right">
              <span id="stageBadge" class="mono text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-sky-100 text-sky-900 border border-sky-400">Etapa 1</span>
              <div class="flex items-center justify-end gap-1 mt-1" id="stageDots"></div>
            </div>
          </div>
          <div class="relative z-10 flex-1 flex flex-col justify-between space-y-2.5">
            <div>
              <h3 id="stageTitle" class="text-xs sm:text-sm font-extrabold text-stone-900 uppercase tracking-tight">Aguardando paciente</h3>
              <p id="stagePrompt" class="text-xs sm:text-[13px] text-stone-700 mt-0.5 leading-snug"></p>
            </div>
            <div id="stageInteractionArea" class="space-y-2"></div>
            <div id="feedbackContainer" class="hidden rounded-lg p-2.5 border-2">
              <h4 id="feedbackTitle" class="text-xs font-extrabold"></h4>
              <p id="feedbackText" class="text-xs mt-0.5 leading-snug"></p>
            </div>
            <div class="pt-2 border-t border-stone-300 flex items-center justify-between gap-3">
              <button id="btnNextStage" type="button" class="hidden flex-1 py-2 px-3 bg-white hover:bg-amber-50 border-2 border-stone-900 shadow-[3px_3px_0px_#1c1917] active:translate-y-0.5 transition flex items-center justify-center gap-2">
                <span class="serif-doc font-bold text-xs sm:text-sm text-stone-900 tracking-wide">Avançar Etapa →</span>
              </button>
              <div class="flex items-center gap-1.5 ml-auto shrink-0">
                <div class="w-7 h-7 rounded-full bg-stone-900 text-white flex items-center justify-center font-black text-xs">+</div>
                <div class="text-[9px] font-extrabold uppercase leading-none text-stone-700">FAMEJIPA<br>CLINIC</div>
              </div>
            </div>
          </div>
        </div>
        <div class="w-full xl:w-72 tractor-paper rounded-sm flex items-stretch shrink-0">
          <div class="w-3.5 border-r border-stone-700/40 tractor-holes shrink-0"></div>
          <div class="flex-1 p-2.5 flex flex-col justify-between text-stone-900 mono text-[11px] min-w-0">
            <div>
              <div class="border-b-2 border-stone-800 pb-1 mb-2 flex items-center justify-between">
                <span class="font-extrabold text-[10px] uppercase tracking-wider">LAUDO • BANCADA</span>
                <span id="labProtocolBadge" class="text-[9px] bg-stone-900 text-emerald-300 px-1 rounded">SINAN</span>
              </div>
              <div class="grid grid-cols-3 gap-1 mb-2 font-sans">
                <button id="btnLabHemo" type="button" class="p-1 rounded bg-white/90 hover:bg-amber-100 border-2 border-stone-900 text-[10px] font-bold flex flex-col items-center transition"><span>🩸 Hemo</span><span id="statusLabHemo" class="text-[8px] text-emerald-700">Solicitar</span></button>
                <button id="btnLabBio" type="button" class="p-1 rounded bg-white/90 hover:bg-amber-100 border-2 border-stone-900 text-[10px] font-bold flex flex-col items-center transition"><span>🧪 Bioq</span><span id="statusLabBio" class="text-[8px] text-emerald-700">Solicitar</span></button>
