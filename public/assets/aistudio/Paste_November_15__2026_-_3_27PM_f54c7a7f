      if (!c) { requestAnimationFrame(drawCartoonPatient); return; }

      if (charAnim.walkingIn) {
        charAnim.xOffset += (0 - charAnim.xOffset) * 0.09;
        charAnim.bobPhase += 0.28;
        if (Math.abs(charAnim.xOffset) < 2.5) {
          charAnim.xOffset = 0; charAnim.walkingIn = false;
          enteringOverlay.classList.add('hidden'); enteringOverlay.classList.remove('flex');
          if (soundEnabled && userGesture) speakPatient(patientStoryText());
        }
      } else charAnim.bobPhase += 0.045;

      const centerX = Math.floor(w * 0.45) + charAnim.xOffset;
      const walkBob = charAnim.walkingIn ? Math.abs(Math.sin(charAnim.bobPhase)) * 10 : Math.sin(charAnim.bobPhase) * 2.5;
      const reserved = speechBubbleHeight + 24;
      const fit = Math.max(0.5, Math.min(1, (h - reserved) / 300));
      charAnim.fit += (fit - charAnim.fit) * 0.15;
      const scale = charAnim.fit * Math.min(1.05, c.heightCm / 178);
      charAnim.geom = { baseY: h - walkBob, scale };

      rctx.save();
      rctx.translate(centerX, h - walkBob);
      rctx.scale(scale, scale);
      rctx.lineWidth = 4; rctx.strokeStyle = '#1c1917'; rctx.lineJoin = 'round'; rctx.lineCap = 'round';

      const exam = charAnim.exam;
      let part = null, p = 0, env = 0;
      if (exam) {
        p = (performance.now() - exam.start) / exam.dur;
        if (p >= 1) charAnim.exam = null;
        else { part = exam.part; env = Math.sin(p * Math.PI); }
      }
      const pain = Boolean(part && exam.pain && (part === 'abdomen' || part === 'legs'));
      const mouthOpen = Boolean(pain || (part === 'thorax' && Math.sin(p * Math.PI * 4) > 0.15) || (ttsSpeaking && Math.sin(performance.now() / 120) > 0));
      const headExam = part === 'head';
      const lightSide = headExam ? (p < 0.5 ? -1 : 1) : 0;

      rctx.translate(pain ? Math.sin(p * 60) * 4 * env : 0, (part === 'legs' ? 15 * env : 0) + (part === 'thorax' ? Math.sin(p * Math.PI * 8) * 5 * env : 0));
      if (part === 'head') {
        rctx.translate(0, -110); rctx.rotate(-0.08 * env); rctx.translate(0, 110);
      } else if (pain) {
        rctx.translate(0, -110); rctx.rotate(0.08 * env); rctx.translate(0, 110);
      }

      // ombros / camisa
      rctx.fillStyle = c.shirtColor;
      rctx.beginPath();
      rctx.moveTo(-92, 6); rctx.quadraticCurveTo(-84, -108, -42, -118);
      rctx.lineTo(42, -118); rctx.quadraticCurveTo(84, -108, 92, 6); rctx.closePath();
      rctx.fill(); rctx.stroke();

      // barriga gravídica (Caso 6)
      if (c.isPregnant) {
        rctx.fillStyle = c.shirtColor;
        rctx.beginPath();
        rctx.ellipse(0, -30, 85, 50, 0, 0, Math.PI * 2);
        rctx.fill(); rctx.stroke();
      }

      if (!c.isFemale) {
        rctx.beginPath(); rctx.moveTo(0, -115); rctx.lineTo(0, -68); rctx.stroke();
        rctx.fillStyle = '#d6d3d1'; rctx.fillRect(-4, -95, 8, 14); rctx.strokeRect(-4, -95, 8, 14);
        rctx.fillStyle = c.collarColor;
        rctx.beginPath(); rctx.moveTo(-42, -118); rctx.lineTo(-12, -105); rctx.lineTo(-32, -92); rctx.closePath(); rctx.fill(); rctx.stroke();
        rctx.beginPath(); rctx.moveTo(42, -118); rctx.lineTo(12, -105); rctx.lineTo(32, -92); rctx.closePath(); rctx.fill(); rctx.stroke();
      }

      if (c.isFemale) {
        rctx.fillStyle = c.hairColor;
        [-1, 1].forEach((sg) => {
          rctx.beginPath(); rctx.moveTo(sg * 66, -235);
          rctx.quadraticCurveTo(sg * 104, -150, sg * 92, -40);
          rctx.lineTo(sg * 50, -42); rctx.lineTo(sg * 52, -190); rctx.closePath();
          rctx.fill(); rctx.stroke();
        });
      }

      // pescoço
      rctx.fillStyle = c.skinColor; rctx.beginPath(); rctx.rect(-24, -142, 48, 30); rctx.fill(); rctx.stroke();

      if (c.isFemale) {
        rctx.fillStyle = c.skinColor;
        rctx.beginPath(); rctx.moveTo(-30, -118); rctx.quadraticCurveTo(0, -84, 30, -118); rctx.closePath(); rctx.fill();
        rctx.beginPath(); rctx.moveTo(-30, -118); rctx.quadraticCurveTo(0, -84, 30, -118); rctx.stroke();
      }

      // orelhas
      rctx.fillStyle = c.skinColor;
      rctx.beginPath(); rctx.ellipse(-66, -195, 14, 24, -0.1, 0, Math.PI * 2); rctx.fill(); rctx.stroke();
      rctx.beginPath(); rctx.ellipse(66, -195, 14, 24, 0.1, 0, Math.PI * 2); rctx.fill(); rctx.stroke();

      // cabeça
      rctx.fillStyle = c.skinColor; rctx.beginPath(); rctx.roundRect(-60, -265, 120, 134, 48); rctx.fill(); rctx.stroke();

      // olhos
      charAnim.blinkTimer = (charAnim.blinkTimer + 1) % 220;
      const isBlinking = charAnim.blinkTimer > 212;
      [-24, 24].forEach((ex) => {
        rctx.fillStyle = c.scleraColor; rctx.lineWidth = 3;
        rctx.beginPath(); rctx.ellipse(ex, -202, 13, isBlinking ? 2 : 11 + (headExam ? 2.5 * env : 0), 0, 0, Math.PI * 2); rctx.fill(); rctx.stroke();
        if (!isBlinking) {
          const pr = headExam ? 4.5 - 2 * env : 4.5, px = ex + lightSide * 3.5 * env;
          rctx.fillStyle = '#1c1917'; rctx.beginPath(); rctx.arc(px, -202, pr, 0, Math.PI * 2); rctx.fill();
          rctx.fillStyle = '#ffffff'; rctx.beginPath(); rctx.arc(px - 1.5, -204, 1.5, 0, Math.PI * 2); rctx.fill();
        }
      });

      if (c.isFemale && !isBlinking) {
        rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 2.5;
        [-1, 1].forEach((sg) => {
          rctx.beginPath();
          rctx.moveTo(sg * 35, -207); rctx.lineTo(sg * 42, -213);
          rctx.moveTo(sg * 37, -202); rctx.lineTo(sg * 45, -205);
          rctx.stroke();
        });
      }

      if (c.hasGlasses) {
        rctx.strokeStyle = '#e7e5e4'; rctx.lineWidth = 5;
        rctx.beginPath(); rctx.arc(-24, -202, 18, 0, Math.PI * 2); rctx.stroke();
        rctx.beginPath(); rctx.arc(24, -202, 18, 0, Math.PI * 2); rctx.stroke();
        rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 2.5;
        rctx.beginPath(); rctx.arc(-24, -202, 19, 0, Math.PI * 2); rctx.stroke();
        rctx.beginPath(); rctx.arc(24, -202, 19, 0, Math.PI * 2); rctx.stroke();
        rctx.beginPath(); rctx.moveTo(-5, -202); rctx.lineTo(5, -202); rctx.stroke();
      }

      // sobrancelhas
      rctx.strokeStyle = '#1c1917'; rctx.lineWidth = c.isFemale ? 3 : 4.5;
      rctx.beginPath();
      rctx.moveTo(-40, -224); rctx.lineTo(-10, -220 - (pain ? 8 * env : 0));
      rctx.moveTo(40, -224); rctx.lineTo(10, -220 - (pain ? 8 * env : 0));
      rctx.stroke();

      // nariz
      rctx.fillStyle = c.skinColor; rctx.lineWidth = 3.5;
      rctx.beginPath(); rctx.moveTo(-6, -204); rctx.quadraticCurveTo(-16, -172, 0, -170); rctx.quadraticCurveTo(16, -172, 6, -204); rctx.fill(); rctx.stroke();

      // boca / bigode
      if (c.hasMustache) {
        rctx.fillStyle = '#3f3f46';
        rctx.beginPath();
        rctx.moveTo(0, -168); rctx.quadraticCurveTo(-28, -170, -38, -154);
        rctx.quadraticCurveTo(-18, -152, 0, -158);
        rctx.quadraticCurveTo(18, -152, 38, -154);
        rctx.quadraticCurveTo(28, -170, 0, -168); rctx.closePath();
        rctx.fill(); rctx.stroke();
      } else if (!c.isFemale && !mouthOpen) {
        rctx.beginPath();
        if (stability >= 88) rctx.arc(0, -162, 12, 0.15 * Math.PI, 0.85 * Math.PI);
        else if (stability >= 45) { rctx.moveTo(-10, -155); rctx.lineTo(10, -155); }
        else rctx.arc(0, -148, 12, 1.15 * Math.PI, 1.85 * Math.PI);
        rctx.stroke();
      }

      if (mouthOpen) {
        rctx.fillStyle = '#450a0a'; rctx.lineWidth = 3; rctx.strokeStyle = '#1c1917';
        rctx.beginPath(); rctx.ellipse(0, c.hasMustache ? -144 : -151, 11, 8, 0, 0, Math.PI * 2); rctx.fill(); rctx.stroke();
      }

      if (c.isFemale) {
        rctx.fillStyle = 'rgba(244,63,94,0.28)';
        [-40, 40].forEach((x) => { rctx.beginPath(); rctx.arc(x, -166, 9, 0, Math.PI * 2); rctx.fill(); });
        if (!mouthOpen) {
          rctx.beginPath();
          if (stability >= 88) rctx.arc(0, -162, 12, 0.15 * Math.PI, 0.85 * Math.PI);
          else rctx.arc(0, -150, 12, 1.15 * Math.PI, 1.85 * Math.PI);
          rctx.strokeStyle = '#be123c'; rctx.lineWidth = 7; rctx.stroke();
          rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 2; rctx.stroke();
        }
      }

      // cabelo
      rctx.fillStyle = c.hairColor; rctx.lineWidth = 4;
      rctx.beginPath();
      rctx.moveTo(-64, -205); rctx.quadraticCurveTo(-76, -255, -40, -278);
      rctx.quadraticCurveTo(0, -292, 44, -276); rctx.quadraticCurveTo(76, -255, 64, -205);
      rctx.quadraticCurveTo(52, -238, 22, -242); rctx.quadraticCurveTo(0, -232, -28, -242);
      rctx.quadraticCurveTo(-52, -238, -64, -205); rctx.closePath();
      rctx.fill(); rctx.stroke();

      if (c.isFemale) {
        rctx.fillStyle = c.hairColor; rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 4;
        [-1, 1].forEach((sg) => {
          rctx.beginPath(); rctx.moveTo(sg * 58, -238);
          rctx.quadraticCurveTo(sg * 76, -200, sg * 60, -150);
          rctx.quadraticCurveTo(sg * 50, -188, sg * 44, -232); rctx.closePath();
          rctx.fill(); rctx.stroke();
        });
        rctx.fillStyle = '#facc15'; rctx.lineWidth = 2.5;
        [-76, 76].forEach((x) => { rctx.beginPath(); rctx.arc(x, -168, 5, 0, Math.PI * 2); rctx.fill(); rctx.stroke(); });
      }

      // pin crachá
      rctx.fillStyle = c.dia === 2 ? '#db2777' : '#dc2626';
      rctx.fillRect(-38, -82, 14, 14);
      rctx.strokeRect(-38, -82, 14, 14);
      rctx.strokeStyle = '#ffffff';
      rctx.lineWidth = 2;
      rctx.beginPath();
      rctx.moveTo(-34, -78); rctx.lineTo(-28, -72);
      rctx.moveTo(-28, -78); rctx.lineTo(-34, -72);
      rctx.stroke();

      // instrumentos de exame
      if (part) {
        rctx.strokeStyle = '#1c1917';
        rctx.lineWidth = 3;

        if (part === 'head') {
          const side = p < 0.5 ? -1 : 1, tx = side * 24, tipX = tx + side * 34, tipY = -198;
          rctx.fillStyle = 'rgba(253,224,71,0.55)';
          rctx.beginPath(); rctx.moveTo(tipX, tipY); rctx.lineTo(tx, -216); rctx.lineTo(tx, -180); rctx.closePath(); rctx.fill();
          rctx.lineWidth = 16; rctx.beginPath(); rctx.moveTo(tipX + side * 6, tipY + 3); rctx.lineTo(tipX + side * 130, tipY + 78); rctx.stroke();
          rctx.strokeStyle = '#94a3b8'; rctx.lineWidth = 10; rctx.beginPath(); rctx.moveTo(tipX + side * 6, tipY + 3); rctx.lineTo(tipX + side * 130, tipY + 78); rctx.stroke();
        } else if (part === 'thorax') {
          const spots = [[-30, -70], [30, -70], [-30, -40], [30, -40]];
          const sp = spots[Math.floor(p * 4) % 4];
          rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 4;
          rctx.beginPath(); rctx.moveTo(sp[0], sp[1]); rctx.quadraticCurveTo(-140, sp[1] - 20, -150, -130); rctx.stroke();
          rctx.lineWidth = 3; rctx.fillStyle = '#e2e8f0';
          rctx.beginPath(); rctx.arc(sp[0], sp[1], 13, 0, Math.PI * 2); rctx.fill(); rctx.stroke();
        } else if (part === 'abdomen') {
          const hx = Math.cos(p * 18) * 16, hy = -22 + Math.sin(p * 18) * 8;
          rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 24;
          rctx.beginPath(); rctx.moveTo(-170, 10); rctx.lineTo(hx - 14, hy); rctx.stroke();
          rctx.strokeStyle = '#f8fafc'; rctx.lineWidth = 18;
          rctx.beginPath(); rctx.moveTo(-170, 10); rctx.lineTo(hx - 14, hy); rctx.stroke();
          rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 3; rctx.fillStyle = c.isPregnant ? '#38bdf8' : '#e2e8f0';
          rctx.beginPath(); rctx.arc(hx, hy, 16, 0, Math.PI * 2); rctx.fill(); rctx.stroke();
          [-9, 0, 9].forEach((dx) => { rctx.beginPath(); rctx.arc(hx + dx, hy - 15, 5, 0, Math.PI * 2); rctx.fill(); rctx.stroke(); });
        } else if (part === 'legs') {
          const swing = Math.sin(p * Math.PI * 3) * 8 * env;
          rctx.strokeStyle = '#1c1917'; rctx.lineWidth = 8;
          rctx.beginPath(); rctx.moveTo(160, -180 + swing); rctx.lineTo(118, -145 + swing); rctx.stroke();
          rctx.fillStyle = '#dc2626'; rctx.lineWidth = 3;
          rctx.beginPath(); rctx.roundRect(105, -155 + swing, 28, 18, 5); rctx.fill(); rctx.stroke();
        }

        if (pain) {
          rctx.fillStyle = '#7dd3fc'; rctx.lineWidth = 2; rctx.strokeStyle = '#1c1917';
          rctx.beginPath(); rctx.ellipse(74, -165 + env * 10, 5, 8, 0, 0, Math.PI * 2); rctx.fill(); rctx.stroke();
        }
      }

      rctx.restore();
      requestAnimationFrame(drawCartoonPatient);
    }

