    function handleMcqAnswer(opt, btnElement) {
      if (stageAnswered) return;
      const c = CASES[currentCaseIndex];
      const stage = c.stages[currentStageIndex];
      const key = `${c.id}:${currentStageIndex}`;
      const firstTime = !scoredStages[key];

      if (opt.correct) {
        stageAnswered = true;
        playSound('success');
        if (firstTime) { scoredStages[key] = true; score += 100; stability = Math.min(100, stability + 10); }
        btnElement.className = 'w-full text-left p-2 rounded bg-emerald-100 border-2 border-emerald-700 shadow-[2px_2px_0px_#065f46] flex items-start gap-2';
        showFeedback(true, firstTime ? '✓ Conduta correta (+100 pts)' : '✓ Correto (revisão, sem pontos)', opt.feedback);
        addLog(`<strong>Acerto:</strong> ${escapeHtml(opt.feedback)}`, 'success', stage.obj);
      } else {
        playSound('error');
        if (firstTime) { score = Math.max(0, score - 30); stability = Math.max(0, stability - 18); }
        btnElement.disabled = true;
        btnElement.className = 'w-full text-left p-2 rounded bg-rose-100 border-2 border-rose-700 flex items-start gap-2 opacity-70 cursor-not-allowed';
        showFeedback(false, firstTime ? '✕ Caiu na pegadinha (-30 pts)' : '✕ Incorreto (revisão)', opt.feedback);
        addLog(`<strong>Erro:</strong> ${escapeHtml(opt.feedback)}`, 'warn', stage.obj);
        if (stability < 45 && firstTime) {
          const event = `Paciente ${c.name.split(',')[0]} evoluiu com instabilidade clínica.`;
          adverseEvents.push(event);
          addLog(`⚠️ <strong>Evento adverso:</strong> ${escapeHtml(event)}`, 'critical');
        }
      }
      updateHeaderBadges();
    }

    function evaluateMedMatrix(stage) {
      if (stageAnswered) return;
      const c = CASES[currentCaseIndex];
      const key = `${c.id}:${currentStageIndex}`;
      const firstTime = !scoredStages[key];
      const total = stage.medItems.length;
      if (Object.keys(medChoices).length < total) {
        playSound('error');
        showFeedback(false, 'Receita incompleta', `Marque uma conduta para todos os ${total} itens.`);
        return;
      }
      let correctCount = 0;
      stage.medItems.forEach((m) => {
        const chosen = medChoices[m.id];
        const reasonEl = document.getElementById(`medReason_${m.id}`);
        reasonEl.classList.remove('hidden');
        if (chosen === m.correctAction) {
          correctCount++;
          reasonEl.className = 'text-[10px] mt-0.5 font-bold text-emerald-700';
          reasonEl.textContent = '✓ ' + m.reason;
        } else {
          reasonEl.className = 'text-[10px] mt-0.5 font-bold text-rose-700';
          reasonEl.textContent = '✕ ' + m.reason;
        }
      });
      if (correctCount === total) {
        stageAnswered = true;
        playSound('success');
        if (firstTime) { scoredStages[key] = true; score += 150; stability = Math.min(100, stability + 12); }
        showFeedback(true,
          firstTime ? '✓ Reconciliação perfeita (+150 pts)' : '✓ Correto (revisão)',
          `Todos os ${total} itens manejados corretamente.`);
        addLog(`<strong>Reconciliação:</strong> ${total}/${total} itens corretos.`, 'success', stage.obj);
      } else {
        playSound('error');
        if (firstTime) { score = Math.max(0, score - 40); stability = Math.max(0, stability - 20); }
        showFeedback(false, `Ajuste necessário (${correctCount}/${total})`, 'Reveja as justificativas em vermelho e corrija.');
        if (stability < 45 && firstTime) {
          const event = `Erro de reconciliação em ${c.name.split(',')[0]}.`;
          adverseEvents.push(event);
          addLog(`⚠️ <strong>Evento adverso:</strong> ${escapeHtml(event)}`, 'critical');
        }
      }
      updateHeaderBadges();
    }

