              <button type="button" data-med="${med.id}" data-act="suspend" class="med-btn px-2 py-0.5 rounded bg-stone-100 hover:bg-stone-200 border border-stone-800 text-[10px] font-bold text-stone-800">${stage.suspendLabel || 'Suspender'}</button>
