    }
    function pickVoice(g, caseId) {
      const manual = voiceChoice[caseId];
      if (manual) { const m = ttsVoices.find((v) => v.voiceURI === manual); if (m) return m; }
      return ttsVoices.slice().sort((a, b) => voiceScore(b, g) - voiceScore(a, g))[0] || null;
    }
    function populateVoiceSelect() {
      const sel = document.getElementById('voiceSelect'), c = CASES[currentCaseIndex];
      if (!sel || !c) return;
      const pr = VOICE_PROFILES[c.id] || { g: c.isFemale ? 'f' : 'm' };
      sel.classList.toggle('hidden', !ttsVoices.length);
      const sorted = ttsVoices.slice().sort((a, b) => voiceScore(b, pr.g) - voiceScore(a, pr.g));
      const cur = pickVoice(pr.g, c.id);
      sel.innerHTML = sorted.map((v) => `<option value="${v.voiceURI}"${cur && v.voiceURI === cur.voiceURI ? ' selected' : ''}>${escapeHtml(v.name)}</option>`).join('');
    }
    function stopSpeech() { if (ttsOk) speechSynthesis.cancel(); ttsSpeaking = false; }
    function speakPatient(text, opts = {}) {
      if (!ttsOk || !text) return;
      speechSynthesis.cancel();
      const c = CASES[currentCaseIndex], pr = VOICE_PROFILES[c.id] || { g: c.isFemale ? 'f' : 'm', pitch: 1, rate: 1 };
      const u = new SpeechSynthesisUtterance(text), v = pickVoice(pr.g, c.id);
      if (v) { try { u.voice = v; } catch (e) {} }
      u.lang = 'pt-BR';
      const health = Math.max(0, Math.min(1, stability / 100)), sp = vs ? vs.spo2 : 97;
      const natural = v && /natural|neural|online/i.test(v.name), k = natural ? 0.2 : 0.4;
      u.pitch = Math.max(0.5, Math.min(1.6, (1 + (pr.pitch - 1) * k) * (opts.pain ? 1.05 : 1)));
      u.rate = Math.max(0.75, Math.min(1.25, (1 + (pr.rate - 1) * 0.5) * (0.88 + 0.12 * health) * (sp < 90 ? 0.95 : 1) * (opts.pain ? 1.05 : 1)));
      u.volume = 0.55 + 0.45 * health;
      u.onstart = () => { ttsSpeaking = true; };
      u.onend = u.onerror = () => { ttsSpeaking = false; };
      speechSynthesis.speak(u);
    }
    function patientStoryText() { const c = CASES[currentCaseIndex]; return c ? c.story.replace(/[\"“”]/g, '') : ''; }

    // ===== Sinais vitais dinâmicos =====
    function initVitals(c) {
      const [sys, dia] = String(c.vitals.bp).split('/').map(Number);
      const base = { hr: c.vitals.hr, sys: sys || 110, dia: dia || 70, spo2: parseInt(c.vitals.spo2, 10) || 96 };
      vs = { base, stab0: solvedCases[c.id] ? 96 : (c.bonus ? 75 : 82), hr: base.hr, sys: base.sys, dia: base.dia, spo2: base.spo2,
             lastTgt: null, lastStab: stability, trend: {}, trendUntil: 0 };
      renderVitals();
    }

    function vitalsTargets() {
      const b = vs.base;
      const f = stability >= vs.stab0
        ? (stability - vs.stab0) / Math.max(1, 100 - vs.stab0)
        : (stability - vs.stab0) / Math.max(1, vs.stab0);
      const better = Math.max(0, f) * 0.72, worse = Math.max(0, -f);
      const isHypertensive = b.sys >= 150;
      const N = {
        hr: Math.min(b.hr, 76),
        sys: isHypertensive ? 136 : Math.max(b.sys, 118),
        dia: isHypertensive ? 86 : Math.max(b.dia, 76),
        spo2: Math.max(b.spo2, 98)
      };
      const W = {
        hr: 42,
        sys: isHypertensive ? 22 : -38,
        dia: isHypertensive ? 14 : -22,
        spo2: -11
      };
      const t = {};
      ['hr', 'sys', 'dia', 'spo2'].forEach((k) => { t[k] = b[k] + (N[k] - b[k]) * better + W[k] * worse; });
      return t;
    }

    function vitalsTick() {
      const c = CASES[currentCaseIndex]; if (!c || !vs) return;
      const tgt = vitalsTargets(), now = performance.now(), sec = now / 1000, r = (a) => (Math.random() * 2 - 1) * a;
      if (stability !== vs.lastStab) {
        vs.lastStab = stability; vs.trendUntil = now + 8000;
        ['hr', 'sys', 'dia', 'spo2'].forEach((k) => { vs.trend[k] = Math.sign(tgt[k] - (vs.lastTgt ? vs.lastTgt[k] : tgt[k])); });
      }
      vs.lastTgt = tgt;
      const off = {
        hr: 3.2 * Math.sin(sec / 3.1) + 1.8 * Math.sin(sec / 1.3 + 1) + r(1.8),
        sys: 4.2 * Math.sin(sec / 4.3 + 2) + r(2.2),
        dia: 2.0 * Math.sin(sec / 4.3 + 2.4) + r(1.4),
        spo2: 1.0 * Math.sin(sec / 5.7) + r(0.7)
      };
      const lim = { hr: [42, 180], sys: [60, 210], dia: [35, 130], spo2: [70, 100] };
      ['hr', 'sys', 'dia', 'spo2'].forEach((k) => {
        const goal = Math.max(lim[k][0], Math.min(lim[k][1], tgt[k] + off[k]));
        vs[k] += (goal - vs[k]) * 0.4;
      });
      if (vs.sys < vs.dia + 15) vs.sys = vs.dia + 15;
      renderVitals();
    }

    function renderVitals() {
      if (!vs) return;
      const hr = Math.round(vs.hr), sys = Math.round(vs.sys), dia = Math.round(vs.dia), sp = Math.min(100, Math.round(vs.spo2));
      const showTrend = performance.now() < vs.trendUntil;
      const arrow = (k) => (showTrend && vs.trend[k] ? (vs.trend[k] > 0 ? ' ↑' : ' ↓') : '');
      vitalHR.textContent = `${hr}${arrow('hr')}`;
      vitalBP.textContent = `${sys}/${dia}${arrow('sys')}`;
      vitalSpO2.textContent = `${sp}%${arrow('spo2')}`;
      const flag = (el, base, bad) => { el.classList.toggle(base, !bad); el.classList.toggle('text-rose-400', bad); };
      flag(vitalHR, currentDay === 2 ? 'text-fuchsia-400' : 'text-emerald-400', hr > 118 || hr < 50);
      flag(vitalBP, 'text-amber-400', sys < 90 || sys >= 160 || dia >= 110);
      flag(vitalSpO2, 'text-sky-400', sp < 91);
    }

